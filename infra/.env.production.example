# Dev/test values only. Copy to .env.production on the VPS and replace domains,
# usernames and release tag. Never commit that file or put passwords here.
DB_DATABASE=hub
DB_OWNER_USERNAME=hub_owner
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
HUB_DB_APP_USERNAME=hub_app_login
HUB_DOMAIN=hub.example.com
HUB_API_URL=https://hub.example.com
WP_DOMAIN=www.example.com
SANCTUM_STATEFUL_DOMAINS=hub.example.com
ACME_EMAIL=admin@example.com
# Correo saliente (SMTP del proveedor). La contraseña va en secrets/mail_password.txt.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp-user@example.com
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=AlojamientoPlus
# URL pública del portal: base de los enlaces de los correos ({url}/#/activar?token=...).
HUB_PORTAL_URL=https://portal.example.com
HUB_RELEASE=2026.10.26-1
SECRETS_DIR=./secrets
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
