# =====================================================================
# Variables de infra/docker-compose.yml. Copiar a infra/.env (ignorado por git).
# Valores de EJEMPLO para desarrollo; en staging/producción usar contraseñas
# propias y no reutilizar estas.
#
# DB_DATABASE / DB_USERNAME / DB_PASSWORD deben coincidir con backend/.env
# si se ejecuta artisan desde el host. Cambiarlas después del primer arranque
# no modifica el usuario ya creado en el volumen postgres_data.
# =====================================================================

# --- PostgreSQL 16 (servicio postgres) ---
DB_DATABASE=hub
DB_USERNAME=hub_owner
DB_PASSWORD=hub_secret_password
# Puerto e interfaz publicados en el host (127.0.0.1 = solo esta máquina).
DB_PORT=5432
DB_BIND=127.0.0.1

# Producción/staging: la aplicación NO debe conectarse como dueño (hub_owner).
# Tras migrar con hub_owner, cree el usuario restringido (hereda de hub_app):
#   HUB_DB_APP_PASSWORD='<secreto>' php artisan hub:db:app-user
# y luego use en backend/.env DB_USERNAME=hub_app_login y DB_PASSWORD=<secreto>.
# Las migraciones y seeders siguen ejecutándose con hub_owner.
# HUB_DB_APP_USERNAME=hub_app_login
# HUB_DB_APP_PASSWORD=

# --- Redis (servicio redis) ---
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# --- Nginx (servicio web: API Laravel) ---
HTTP_PORT=8080

# --- WordPress + MariaDB (servicios wordpress y wordpress_db) ---
WP_PORT=8000
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=wp_password
WP_DB_ROOT_PASSWORD=wp_root_password
