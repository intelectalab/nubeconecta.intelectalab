# =====================================================================
# hub — backend Laravel. Copiar a .env y ajustar.
# Los valores son de EJEMPLO para desarrollo local; no son secretos reales.
#
# Dos formas de ejecutar:
#  a) Docker (infra/docker-compose.yml): los contenedores app/worker/scheduler
#     reciben DB_HOST=postgres y REDIS_HOST=redis por variables de entorno,
#     que tienen prioridad sobre este archivo.
#  b) artisan en el host: usa DB_HOST/REDIS_HOST=127.0.0.1 y los puertos que
#     publica el compose (DB_PORT, REDIS_PORT de infra/.env).
#     Requiere la extensión pdo_pgsql en el PHP del host.
# =====================================================================

# Nombre comercial pendiente (D-17); también fija el prefijo de Redis/Horizon.
APP_NAME=hub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 (servicio `postgres` del compose). Deben coincidir con infra/.env.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hub
DB_USERNAME=hub_owner
DB_PASSWORD=hub_secret_password
# Ruta de database/schema.sql que carga la migración base (opcional).
# HUB_SCHEMA_PATH=

# Sesiones en Redis (las SPA usan Sanctum con cookie de sesión).
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie HttpOnly/Secure/SameSite (M-IDN §5): en producción SESSION_SECURE_COOKIE=true.
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Ajustes técnicos del hub (config/hub.php). Las reglas de negocio viven en settings.
# HUB_ORGANIZATION_ID=
HUB_ORGANIZATION_NAME=Hub
HUB_ORGANIZATION_SLUG=hub
# HUB_SEEDS_PATH=
HUB_PROBLEM_BASE_URI=https://hub.example/problems
HUB_IDEMPOTENCY_TTL_HOURS=24
HUB_IDEMPOTENCY_LOCK_SECONDS=30
HUB_LOGIN_IP_ATTEMPTS_PER_MINUTE=20
HUB_MFA_PENDING_MINUTES=10
HUB_MFA_MAX_ATTEMPTS=5
# Bóveda: obligatoria en producción; base64 de 32 bytes. Generar con: php -r "echo base64_encode(random_bytes(32));"
HUB_VAULT_KEY=
HUB_VAULT_KEY_VERSION=1
# HUB_WP_REQUESTS_PER_MINUTE=120
# Services/Billing (franja MVP): activar servicios y emitir comprobantes al aprobar el pedido (demo),
# y conector de facturación electrónica (fake = simulación con CDR ficticio, no vale en producción; D-01).
# HUB_SERVICES_AUTO_ACTIVATE=false
# HUB_BILLING_AUTO_ISSUE=false
# HUB_EINVOICE_DRIVER=fake
# Constancias de pago (vouchers): disco privado y tamaño máximo en KB.
# HUB_BILLING_PROOFS_DISK=local
# HUB_BILLING_PROOF_MAX_KB=5120
# Pago con tarjeta: Mercado Pago Checkout Pro (Tus integraciones > Credenciales y > Webhooks).
# Sin MP_ACCESS_TOKEN y MP_WEBHOOK_SECRET el portal no muestra "Pagar con tarjeta".
HUB_CARD_GATEWAY_DRIVER=mercadopago
HUB_PORTAL_URL=http://localhost:5173
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
MP_CURRENCIES=PEN
# MP_NOTIFICATION_URL=https://<tunel-publico>/api/v1/webhooks/mercadopago
# MP_STATEMENT_DESCRIPTOR=
# MP_WEBHOOK_TOLERANCE_SECONDS=300
# HUB_CARD_CHECKOUT_EXPIRY_MINUTES=60
# HUB_TOTP_ISSUER=
# Argon2id (config/hashing.php)
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# Orígenes de las SPA que reciben sesión con cookie (admin :3000, portal :3001).
# Subdominios definitivos pendientes (D-19).
# Vida de los tokens bearer de Sanctum en minutos (vacío = sin vencimiento global). Ver docs/10.
SANCTUM_EXPIRATION=480
# Usuario de BD restringido (php artisan hub:db:app-user, con DB_USERNAME=hub_owner):
# HUB_DB_APP_USERNAME=hub_app_login
# HUB_DB_APP_PASSWORD=
# Destinos salientes privados (SSRF): solo efectivo con APP_ENV=local o testing.
# HUB_OUTBOUND_ALLOW_PRIVATE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,127.0.0.1,127.0.0.1:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas en Redis procesadas por Horizon (config/horizon.php).
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis/predis está en composer.json (no requiere la extensión phpredis).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Desarrollo local sin Docker: MAIL_MAILER=log escribe el correo (con el enlace) en storage/logs/laravel.log.
# Con Docker (infra/docker-compose.yml) el correo va a Mailpit: http://localhost:8025.
# Producción: ver backend/README.md ("Correo del portal").
# Base de los enlaces de invitación y restablecimiento: {HUB_PORTAL_URL}/#/activar?token=...
HUB_PORTAL_URL=http://localhost:3001
# HUB_INVITATION_HOURS=72
# HUB_PASSWORD_RESET_MINUTES=60

# Bucket de respaldos pendiente (D-10).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Puertos publicados por infra/docker-compose.yml. Los lee Docker Compose
# desde infra/.env (ver infra/.env.example), no Laravel; se listan aquí
# solo como referencia.
# HTTP_PORT=8080
# WP_PORT=8000
